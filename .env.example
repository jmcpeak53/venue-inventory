# Copy this file to `.env` only when you want to override the local Compose
# defaults. Docker Compose reads these values automatically if `.env` exists.

# At least 32 characters. Replace before any shared or production use.
VENUE_INVENTORY_SECRET_KEY=local-dev-secret-key-please-change-32

# At least 32 characters. Keep this stable between deployments so existing
# customer access codes remain usable.
VENUE_INVENTORY_ACCESS_CODE_HMAC_SECRET=local-dev-access-code-hmac-secret-please-change-32

# Argon2id hash of the shared administrator password. Double each `$` so
# Compose does not treat it as a variable. Generate a replacement with:
# docker compose run --rm --no-deps --entrypoint python web -m app.hash_password
# That command also prints a Compose-ready line you can paste here.
VENUE_INVENTORY_ADMIN_PASSWORD_HASH=$$argon2id$$v=19$$m=65536,t=3,p=4$$p+GWcgPvN61qwVQskNrWfw$$A2jSd5WGZ4OS1b+eTkqth1qjiWAhMaLmpc7khoup98Q

# Optional. Container path to a file containing the same Argon2id hash.
# Use this instead of doubling `$` above. The path is read inside the
# container (for example /data/admin-password.hash), not a host path.
# When set, it takes precedence over VENUE_INVENTORY_ADMIN_PASSWORD_HASH.
# VENUE_INVENTORY_ADMIN_PASSWORD_HASH_FILE=/data/admin-password.hash

# Local HTTP has no TLS, so leave this false until HTTPS is in front.
VENUE_INVENTORY_SESSION_COOKIE_SECURE=false
# Set true only when a trusted HTTP reverse proxy sets X-Forwarded-For
# and X-Forwarded-Proto. Leave false for Compose published ports; Docker
# then shares one rate-limit bucket across clients.
VENUE_INVENTORY_TRUST_PROXY=false
VENUE_INVENTORY_REQUIRE_DATA_MOUNT=true
VENUE_INVENTORY_LOG_LEVEL=INFO
VENUE_INVENTORY_PORT=8080
VENUE_INVENTORY_BIND_ADDRESS=0.0.0.0
